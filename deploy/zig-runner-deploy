#!/usr/bin/env bash
# zig-runner-deploy: installs the release GitHub last recorded as a deployment to this machine's
# environment, restarts the runner instances here, and reports back (docs/OPERATIONS.md, "Deploying releases").
# zig-runner-deploy.timer runs it every minute; with nothing new to deploy it only asks GitHub.
#
# A release is installed only once its binary matches SHA256SUMS and its build provenance says
# release.yml built it from that tag on GitHub's own runners (gh attestation verify), and only if it
# is not older than the one installed (ALLOW_DOWNGRADE). If an instance does not come back
# listening for jobs, the previous binary is put back and the deployment is reported failed.
#
# CHANNEL says what this machine follows (docs/OPERATIONS.md, "Channels"). `stable`, the default,
# is everything above: releases only. `rc` and `main` follow the releases feed instead of
# deployments: `rc` the newest of the release candidates (vX.Y.Z-rcN) and releases, `main` the
# newest main candidate (main-N-SHA), both built by candidate.yml (a release by release.yml) and
# checked as strictly: checksum, provenance from that workflow at that ref and commit, and a
# version not older than the installed one of the same kind. Nothing is reported to GitHub there
# (a feed is read by any number of machines); a candidate that fails a check is remembered in
# STATE_DIR and not tried again. Changing CHANNEL is the explicit act that lets the first install
# after it replace a binary of another channel, whatever its version; it is logged.
#
# Fetching the release can fail for reasons of the moment: no network, GitHub's rate limit, a
# timeout, Sigstore's TUF CDN. Such a failure reports nothing and exits; the timer tries again a
# minute later, and only after ATTEMPTS tries of the same deployment is it reported failed (the
# tries are counted in STATE_DIR). What was fetched is then checked offline, so a check that fails
# is the release's fault, and is reported failed at once: a checksum or provenance mismatch, or a
# release, binary or attestation that does not exist.
#
# Settings, from /etc/zig-runner-deploy.env (deploy/zig-runner-deploy.env.example):
#   GH_TOKEN      fine-grained token: Deployments read/write, Attestations and Contents read
#   REPO          the repository releases come from (Open-Blue/zig-runner)
#   ENVIRONMENT   the GitHub environment this machine deploys (razorbill); stable only
#   CHANNEL       stable (releases, the default), rc (release candidates and releases) or main
#                 (main candidates). One binary has one channel: run another agent, with its own
#                 env file, BIN, UNITS and STATE_DIR, for a pool on another (zig-runner-deploy@.service)
#   UNITS         the instances to restart; empty for every zig-runner.service and
#                 zig-runner@*.service here
#   BIN           the installed binary (/usr/local/bin/zig-runner)
#   GH_TIMEOUT    seconds any one call to GitHub may take (120)
#   ATTEMPTS      tries of a deployment whose release could not be fetched before it is reported
#                 failed, one a minute (30)
#   STATE_DIR     where the tries are counted (systemd's STATE_DIRECTORY, else
#                 /var/lib/zig-runner-deploy)
#   ALLOW_DOWNGRADE  the one older version tag that may replace the installed one (v1.2.3), for a
#                 rollback on purpose; anything older is refused otherwise (stable only)
#   DRY_RUN       set to check a deployment without reporting, installing, restarting or counting
set -euo pipefail

: "${GH_TOKEN:?GH_TOKEN must be set}"
REPO=${REPO:-Open-Blue/zig-runner}
ENVIRONMENT=${ENVIRONMENT:-razorbill}
CHANNEL=${CHANNEL:-stable}
UNITS=${UNITS:-}
BIN=${BIN:-/usr/local/bin/zig-runner}
DRY_RUN=${DRY_RUN:-}
HEALTH_SECONDS=${HEALTH_SECONDS:-120}
GH_TIMEOUT=${GH_TIMEOUT:-120}
ATTEMPTS=${ATTEMPTS:-30}
STATE_DIR=${STATE_DIR:-${STATE_DIRECTORY:-/var/lib/zig-runner-deploy}}
ALLOW_DOWNGRADE=${ALLOW_DOWNGRADE:-}
export GH_TOKEN GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1

# Every call to GitHub has a time limit: the service has none of its own (an instance's restart
# waits for its jobs, for up to an hour), and a call that never answered would hold it forever.
GH=$(command -v gh) || {
	echo "zig-runner-deploy: gh is not installed" >&2
	exit 1
}
gh() { timeout "$GH_TIMEOUT" "$GH" "$@"; }

log() { echo "zig-runner-deploy: $*" >&2; }

# A deployment's new state, with a description GitHub shows (140 characters at most).
# A channel's candidate has no deployment (id empty): it is only logged.
report() {
	local id=$1 state=$2 description=$3
	if [[ -z $id ]]; then
		log "$CHANNEL: $state: $description"
		return 0
	fi
	log "deployment $id: $state: $description"
	[[ -n $DRY_RUN ]] && return 0
	gh api -X POST "repos/$REPO/deployments/$id/statuses" \
		-f state="$state" -f description="${description:0:140}" -F auto_inactive=true >/dev/null
}

latest_state() {
	gh api "repos/$REPO/deployments/$1/statuses?per_page=1" --jq '.[0].state // ""'
}

handled() { case $1 in success | failure | error | inactive) return 0 ;; *) return 1 ;; esac }

version_of() { "$1" --version 2>/dev/null | awk '{print $2}'; }

# The instances to restart: UNITS, or every runner unit loaded here, both the plain
# zig-runner.service (deploy/zig-runner.service) and instances of a zig-runner@.service template.
instances() {
	if [[ -n $UNITS ]]; then
		local listed
		read -ra listed <<<"$UNITS"
		printf '%s\n' "${listed[@]}"
	else
		systemctl list-units --all --plain --no-legend 'zig-runner.service' 'zig-runner@*.service' |
			awk '{print $1}'
	fi
}

# The instances systemd does not know (a mistyped UNITS): restarting one would fail only after the
# release is installed, and roll every instance back for nothing.
unknown_units() {
	local unit
	for unit in "$@"; do
		[[ $(systemctl show -p LoadState --value "$unit") == loaded ]] || echo "$unit"
	done
}

# Whether $1 runs the binary installed now: active, and its process's executable is BIN itself. A
# process started from a binary since replaced shows it as "BIN (deleted)": the file on disk alone
# does not say the instances restarted (the agent may have stopped between installing and that).
runs_installed() {
	local pid
	systemctl is-active --quiet "$1" || return 1
	pid=$(systemctl show -p MainPID --value "$1")
	[[ $pid != 0 && $(readlink "/proc/$pid/exe") == "$BIN" ]]
}

# Whether the process systemd started as invocation $2 of $1 has said it is listening. The runner
# says so after every job too, and a stopping process may still say it: only this invocation counts.
listening() {
	systemctl is-active --quiet "$1" &&
		journalctl "_SYSTEMD_INVOCATION_ID=$2" -o cat --no-pager | grep -q 'listening for jobs'
}

# Restarts the instances given; prints the first that does not come back listening, or nothing.
restart_all() {
	local unit invocation deadline
	for unit in "$@"; do
		# A stop lets running jobs finish first (the unit's TimeoutStopSec).
		if ! systemctl restart "$unit"; then
			echo "$unit"
			return
		fi
		invocation=$(systemctl show -p InvocationID --value "$unit")
		deadline=$((SECONDS + HEALTH_SECONDS))
		until listening "$unit" "$invocation"; do
			if ((SECONDS >= deadline)); then
				echo "$unit"
				return
			fi
			sleep 3
		done
	done
}

# Puts $1 at BIN in one step: written beside it, then renamed over it, so BIN is never missing or
# half written.
put() {
	install -m 0755 "$1" "$BIN.new" && mv -f "$BIN.new" "$BIN"
}

# Restarts the instances given onto the installed binary, and reports. If one does not come back,
# the previous binary goes back and every instance is restarted onto it.
finish() {
	local down again
	if [[ -n $DRY_RUN ]]; then
		log "dry run: would restart $* onto $tag"
		exit 0
	fi
	down=$(restart_all "$@")
	if [[ -z $down ]]; then
		record_channel
		report "$id" success "running $tag on $(hostname): $*"
		exit 0
	fi
	if [[ -x $BIN.prev ]] && ! is_tag_version "$BIN.prev" && put "$BIN.prev"; then
		again=$(restart_all "${units[@]}")
		fail "$tag did not come up on $down; back on $(version_of "$BIN")${again:+, $again down}"
	fi
	fail "$tag did not come up on $down, and there is no other binary to go back to"
}

# A candidate that failed a check is remembered (a channel has no deployment to report failed), so
# the timer does not fetch and check it again every minute; a newer candidate is tried as usual.
# Only once its own checks began (judged): a machine's own fault is not the candidate's.
fail() {
	report "$id" failure "$1"
	if [[ -z $id && -n ${judged:-} && -z $DRY_RUN ]]; then
		echo "$tag" >>"$STATE_DIR/rejected" || log "could not remember that $tag was rejected"
	fi
	exit 1
}

# A try at deployment $id failed for a reason of the moment ($1): exits without reporting, so the
# timer tries again, until the ATTEMPTS-th try, which reports the deployment failed.
transient() {
	local tries=1 last_id last_tries
	if read -r last_id last_tries 2>/dev/null <"$STATE_DIR/tries" && [[ $last_id == "$id" ]]; then
		tries=$((last_tries + 1))
	fi
	# A channel has no deployment to give up on: the next minute tries again, for as long as it takes.
	if [[ -z $id ]]; then
		log "$CHANNEL: $1; trying again next time"
		exit 0
	fi
	((tries < ATTEMPTS)) || fail "gave up after $tries tries: $1"
	if [[ -z $DRY_RUN ]]; then
		echo "$id $tries" >"$STATE_DIR/tries" || log "could not count the try in $STATE_DIR/tries"
	fi
	log "deployment $id: try $tries of $ATTEMPTS: $1; trying again next time"
	exit 0
}

# fetch WHAT GH_ARGS...: runs gh, its output going where this function's goes. A release, asset
# or attestation that does not exist fails the deployment; any other failure is transient.
fetch() {
	local what=$1 err status=0
	shift
	{ err=$(gh "$@" 2>&1 1>&3 3>&-); } 3>&1 || status=$?
	((status == 0)) && return 0
	if ((status == 124)); then err="timed out after $GH_TIMEOUT s"; fi
	err=$(tail -n1 <<<"${err:-gh exited $status}")
	case $err in
	*"HTTP 404"* | *"release not found"* | *"no assets match"*) fail "$what: $err" ;;
	*) transient "$what: $err" ;;
	esac
}

# Whether the version $1 is older than $2 (vX.Y.Z, vX.Y.Z-rcN or vX.Y.Z-main.N+SHA), by semver's
# precedence: a pre-release is older than its release, and the build metadata (+SHA) is ignored.
older() {
	local a=${1#v} b=${2#v} core_a core_b pre_a='' pre_b=''
	a=${a%%+*} b=${b%%+*}
	core_a=${a%%-*} core_b=${b%%-*}
	[[ $a == *-* ]] && pre_a=${a#*-}
	[[ $b == *-* ]] && pre_b=${b#*-}
	if [[ $core_a != "$core_b" ]]; then
		[[ $(printf '%s\n' "$core_a" "$core_b" | sort -V | head -n1) == "$core_a" ]]
		return
	fi
	[[ $pre_a == "$pre_b" ]] && return 1
	[[ -z $pre_b ]] && return 0
	[[ -z $pre_a ]] && return 1
	[[ $(printf '%s\n' "$pre_a" "$pre_b" | sort -V | head -n1) == "$pre_a" ]]
}

stable_re='^v[0-9]+\.[0-9]+\.[0-9]+$'
rc_re='^v[0-9]+\.[0-9]+\.[0-9]+-rc[0-9]+$'
main_tag_re='^main-([0-9]+)-([0-9a-f]{12})$'
main_version_re='^v[0-9]+\.[0-9]+\.[0-9]+-main\.([0-9]+)\+([0-9a-f]{12})$'

# Whether the binary $1 says it is the candidate chosen (tag): a release's or release candidate's
# version is its tag; a main candidate's is vX.Y.Z-main.N+SHA for the tag main-N-SHA.
is_tag_version() {
	local version
	version=$(version_of "$1" || true)
	if [[ $kind == main ]]; then
		[[ $version =~ $main_version_re && ${BASH_REMATCH[1]} == "$tag_n" && ${BASH_REMATCH[2]} == "$tag_sha12" ]]
	else
		[[ $version == "$tag" ]]
	fi
}

# What channel the installed binary came from: recorded after each install, `stable` before any.
recorded_channel() { cat "$STATE_DIR/channel" 2>/dev/null || echo stable; }
record_channel() {
	[[ -n $DRY_RUN ]] && return 0
	if ! { mkdir -p "$STATE_DIR" && echo "$CHANNEL" >"$STATE_DIR/channel"; }; then
		log "could not record the channel in $STATE_DIR/channel"
	fi
}

# The newest candidate of the channel in the releases feed (tag, whether it is a pre-release, name
# and creation time, tab-separated, on stdin) that was not rejected: for `main` the highest (base
# version, N); for `rc` the newest version of the release candidates and releases. A tag whose
# pre-release flag disagrees with its form is not a candidate of any channel (a release candidate
# published as latest, say). A main candidate's base version is X.Y.Z of its release's name
# (vX.Y.Z-main.N+SHA12, candidate-version.sh): the run number N restarts from 1 if the candidate
# workflow is ever recreated, and the base, which follows the latest release, then still orders.
# Prints: the tag, its base, and for main the newest candidate by creation time and its base.
main_base() {
	[[ $1 =~ ^v([0-9]+\.[0-9]+\.[0-9]+)-main\. ]] && echo "${BASH_REMATCH[1]}" || echo 0.0.0
}
# Whether main candidate (base $1, N $2) is newer than (base $3, N $4).
main_newer() {
	[[ $1 == "$3" ]] && return $(($2 > $4 ? 0 : 1))
	[[ $(printf '%s\n' "$1" "$3" | sort -V | tail -n1) == "$1" ]]
}
newest_candidate() {
	local tag pre name created n base best='' best_base='' best_n=-1 latest='' latest_base='' latest_created=''
	while IFS=$'\t' read -r tag pre name created; do
		! grep -qxF -- "$tag" "$STATE_DIR/rejected" 2>/dev/null || continue
		if [[ $CHANNEL == main ]]; then
			[[ $pre == true && $tag =~ $main_tag_re ]] || continue
			n=$((10#${BASH_REMATCH[1]}))
			base=$(main_base "$name")
			if [[ -z $best ]] || main_newer "$base" "$n" "$best_base" "$best_n"; then best=$tag best_base=$base best_n=$n; fi
			if [[ -z $latest || $created > $latest_created ]]; then latest=$tag latest_base=$base latest_created=$created; fi
		else
			[[ ($pre == true && $tag =~ $rc_re) || ($pre == false && $tag =~ $stable_re) ]] || continue
			if [[ -z $best ]] || older "$best" "$tag"; then best=$tag; fi
		fi
	done
	echo "${best:--} ${best_base:-0.0.0} ${latest:--} ${latest_base:-0.0.0}"
}

# What this machine needs is checked before any deployment is touched: a deployment reported failed
# for a missing tool would never be tried again, so this exits and the timer tries next minute.
attestation_help=$(gh attestation verify --help 2>&1) || true
for flag in --signer-workflow --source-ref --source-digest --deny-self-hosted-runners --custom-trusted-root; do
	if [[ $attestation_help != *"$flag"* ]]; then
		log "$(gh --version | head -n1) cannot verify provenance (gh attestation verify $flag):" \
			"install gh 2.68 or later from https://cli.github.com (Debian's package is too old)"
		exit 1
	fi
done

case $CHANNEL in
stable | rc | main) ;;
*)
	log "CHANNEL=$CHANNEL: not stable, rc or main"
	exit 1
	;;
esac
mkdir -p "$STATE_DIR" 2>/dev/null || true

# What to install, as `tag` and `kind` (release, rc or main), and `id`, the deployment to report to
# (none on a channel).
id=''
kind=release
switching=''
previous_channel=$(recorded_channel)
[[ $previous_channel == "$CHANNEL" ]] || switching=1

if [[ $CHANNEL == stable ]]; then
	mapfile -t ids < <(
		gh api "repos/$REPO/deployments?environment=$ENVIRONMENT&per_page=10" --jq '.[].id'
	)
	((${#ids[@]} > 0)) || exit 0
	id=${ids[0]}
	state=$(latest_state "$id")
	# A machine moved back to stable takes the newest deployment that went well, though it is
	# handled: nothing else would ever install it again.
	if handled "$state" && ! [[ -n $switching && $state == success ]]; then exit 0; fi

	tag=$(gh api "repos/$REPO/deployments/$id" --jq .ref)
	log "deployment $id: $tag"
	# Older deployments nobody got to: this newer one replaces them.
	for old in "${ids[@]:1}"; do
		handled "$(latest_state "$old")" || report "$old" inactive "superseded by $tag"
	done

	# Only a release: a candidate, however it got into a deployment, is refused here.
	[[ $tag =~ $stable_re ]] || fail "not a version tag: $tag"
else
	feed=$(gh api "repos/$REPO/releases?per_page=100" --jq '.[] | select(.draft | not) | [.tag_name, .prerelease, (.name // "-" | if . == "" then "-" else . end), .created_at] | @tsv') ||
		transient "could not list $REPO's releases"
	read -r tag tag_base latest_tag latest_base < <(newest_candidate <<<"$feed")
	[[ $tag != - ]] || exit 0
	if [[ $tag =~ $main_tag_re ]]; then
		kind=main
	elif [[ $tag =~ $rc_re ]]; then
		kind=rc
	fi
	log "$CHANNEL: newest candidate $tag"
fi
tag_n='' tag_sha12=''
if [[ $kind == main ]]; then
	[[ $tag =~ $main_tag_re ]]
	tag_n=$((10#${BASH_REMATCH[1]}))
	tag_sha12=${BASH_REMATCH[2]}
fi

mapfile -t units < <(instances)
if ((${#units[@]} == 0)); then
	fail "no zig-runner instances on $(hostname)"
fi
mapfile -t unknown < <(unknown_units "${units[@]}")
((${#unknown[@]} == 0)) || fail "no unit ${unknown[*]} on $(hostname) (UNITS); nothing installed"

current=$(version_of "$BIN" || true)
# Moving a machine to another channel is a decision made on the machine (CHANNEL), so the first
# install after it replaces what is there whatever its version; logged, and recorded once it is in.
if [[ -n $switching ]]; then
	log "channel switch: $previous_channel -> $CHANNEL (installed: ${current:-none}); the version order is not checked for this install"
elif [[ $CHANNEL == stable ]]; then
	# Anyone who can create a deployment could otherwise put back an older release, attested as
	# genuinely as any, with the bugs since fixed.
	if [[ $current =~ $stable_re ]] && older "$tag" "$current" && [[ $ALLOW_DOWNGRADE != "$tag" ]]; then
		fail "$tag is older than the installed $current: refused (ALLOW_DOWNGRADE=$tag on $(hostname) allows it)"
	fi
elif [[ $kind == main ]]; then
	# Ordered by (base version, N): the same pair from another commit is not newer either. The
	# installed binary's base is the X.Y.Z of its version.
	if [[ $current =~ $main_version_re ]] && ! is_tag_version "$BIN"; then
		current_n=$((10#${BASH_REMATCH[1]}))
		current_sha12=${BASH_REMATCH[2]}
		if ! main_newer "$tag_base" "$tag_n" "$(main_base "$current")" "$current_n"; then
			log "main: $tag is not newer than the installed $current; nothing to do"
			# The newest published candidate that sorts at or below the installed one: a run number
			# that restarted under the same base stalls the machine here, silently but for this.
			if [[ $latest_tag =~ $main_tag_re && ${BASH_REMATCH[2]} != "$current_sha12" ]] &&
				! main_newer "$latest_base" "$((10#${BASH_REMATCH[1]}))" "$(main_base "$current")" "$current_n"; then
				log "kind=main_candidate_stalled: $latest_tag is the newest published candidate but not newer than the installed $current by (base, run number); did the candidate run numbers restart?"
			fi
			exit 0
		fi
	fi
elif [[ $current =~ $stable_re || $current =~ $rc_re ]] && older "$tag" "$current"; then
	# The newest the feed offers is older than what is installed: nothing to install, not a failure.
	log "$CHANNEL: $tag is older than the installed $current; nothing to do"
	exit 0
fi

# Installed already: done if every instance runs it; otherwise restart those that do not.
if is_tag_version "$BIN"; then
	stale=()
	for unit in "${units[@]}"; do runs_installed "$unit" || stale+=("$unit"); done
	if ((${#stale[@]} == 0)); then
		record_channel
		report "$id" success "already running $tag"
		exit 0
	fi
	report "$id" in_progress "$tag is installed; restarting ${stale[*]} onto it"
	finish "${stale[@]}"
fi

# From here the candidate's own checks run: one that fails is its fault.
judged=1
report "$id" in_progress "installing $tag on $(hostname) (was ${current:-none})"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
asset="zig-runner-linux-$(uname -m)"
# What built it, from which ref: a release, by release.yml from its tag; a release candidate, by
# candidate.yml from its tag; a main candidate, by candidate.yml from main, at the commit its tag names.
signer=release.yml
source_ref="refs/tags/$tag"
digest_args=()
cd "$work"
if [[ $kind != release ]]; then signer=candidate.yml; fi
if [[ $kind == main ]]; then
	source_ref=refs/heads/main
	fetch "could not read the commit of $tag" api "repos/$REPO/git/ref/tags/$tag" --jq .object.sha >"$work/commit"
	commit=$(<"$work/commit")
	[[ $commit =~ ^[0-9a-f]{40}$ && $commit == "$tag_sha12"* ]] || fail "$tag does not point at the commit its name says"
	digest_args=(--source-digest "$commit")
fi
# Each check runs offline, on what was fetched before it, into $work (gh attestation download
# writes there): the binary and SHA256SUMS, then the attestations of the binary's digest and
# Sigstore's trust root.
fetch "could not download $tag's $asset" release download "$tag" -R "$REPO" -D "$work" -p "$asset" -p SHA256SUMS
grep -q "  $asset\$" SHA256SUMS || fail "$asset is not in $tag's SHA256SUMS"
sha256sum --check --ignore-missing --quiet SHA256SUMS ||
	fail "$asset does not match $tag's SHA256SUMS"
digest=$(sha256sum "$asset" | cut -d' ' -f1)
fetch "could not fetch $asset's attestations" attestation download "$asset" -R "$REPO" >/dev/null
fetch "could not fetch Sigstore's trust root" attestation trusted-root >"$work/trusted_root.jsonl"
gh attestation verify "$work/$asset" --repo "$REPO" \
	--bundle "$work/sha256:$digest.jsonl" --custom-trusted-root "$work/trusted_root.jsonl" \
	--signer-workflow "$REPO/.github/workflows/$signer" \
	--source-ref "$source_ref" "${digest_args[@]}" --deny-self-hosted-runners >/dev/null ||
	fail "$asset has no provenance from $signer at $source_ref for $tag"
chmod 0755 "$work/$asset"
is_tag_version "$work/$asset" || fail "$asset does not say it is $tag"

if [[ -z $DRY_RUN ]]; then
	if [[ -e $BIN ]]; then cp -p "$BIN" "$BIN.prev" || fail "could not keep the previous binary"; fi
	put "$work/$asset" || fail "could not install $tag at $BIN (it is unchanged)"
fi
finish "${units[@]}"
