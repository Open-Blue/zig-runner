#!/usr/bin/env bash
# zig-runner-deploy: installs the release GitHub last recorded as a deployment to this machine's
# environment, restarts the runner instances here, and reports back (docs/OPERATIONS.md, "Deploying releases").
# zig-runner-deploy.timer runs it every minute; with nothing new to deploy it only asks GitHub.
#
# A release is installed only once its binary matches SHA256SUMS and its build provenance says
# release.yml built it from that tag on GitHub's own runners (gh attestation verify), and only if it
# is not older than the one installed (ALLOW_DOWNGRADE). If an instance does not come back
# listening for jobs, the previous binary is put back and the deployment is reported failed.
#
# Fetching the release can fail for reasons of the moment: no network, GitHub's rate limit, a
# timeout, Sigstore's TUF CDN. Such a failure reports nothing and exits; the timer tries again a
# minute later, and only after ATTEMPTS tries of the same deployment is it reported failed (the
# tries are counted in STATE_DIR). What was fetched is then checked offline, so a check that fails
# is the release's fault, and is reported failed at once: a checksum or provenance mismatch, or a
# release, binary or attestation that does not exist.
#
# Settings, from /etc/zig-runner-deploy.env (deploy/zig-runner-deploy.env.example):
#   GH_TOKEN      fine-grained token: Deployments read/write, Attestations and Contents read
#   REPO          the repository releases come from (Open-Blue/zig-runner)
#   ENVIRONMENT   the GitHub environment this machine deploys (razorbill)
#   UNITS         the instances to restart; empty for every zig-runner.service and
#                 zig-runner@*.service here
#   BIN           the installed binary (/usr/local/bin/zig-runner)
#   GH_TIMEOUT    seconds any one call to GitHub may take (120)
#   ATTEMPTS      tries of a deployment whose release could not be fetched before it is reported
#                 failed, one a minute (30)
#   STATE_DIR     where the tries are counted (systemd's STATE_DIRECTORY, else
#                 /var/lib/zig-runner-deploy)
#   ALLOW_DOWNGRADE  the one older version tag that may replace the installed one (v1.2.3), for a
#                 rollback on purpose; anything older is refused otherwise
#   DRY_RUN       set to check a deployment without reporting, installing, restarting or counting
set -euo pipefail

: "${GH_TOKEN:?GH_TOKEN must be set}"
REPO=${REPO:-Open-Blue/zig-runner}
ENVIRONMENT=${ENVIRONMENT:-razorbill}
UNITS=${UNITS:-}
BIN=${BIN:-/usr/local/bin/zig-runner}
DRY_RUN=${DRY_RUN:-}
HEALTH_SECONDS=${HEALTH_SECONDS:-120}
GH_TIMEOUT=${GH_TIMEOUT:-120}
ATTEMPTS=${ATTEMPTS:-30}
STATE_DIR=${STATE_DIR:-${STATE_DIRECTORY:-/var/lib/zig-runner-deploy}}
ALLOW_DOWNGRADE=${ALLOW_DOWNGRADE:-}
export GH_TOKEN GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1

# Every call to GitHub has a time limit: the service has none of its own (an instance's restart
# waits for its jobs, for up to an hour), and a call that never answered would hold it forever.
GH=$(command -v gh) || {
	echo "zig-runner-deploy: gh is not installed" >&2
	exit 1
}
gh() { timeout "$GH_TIMEOUT" "$GH" "$@"; }

log() { echo "zig-runner-deploy: $*" >&2; }

# A deployment's new state, with a description GitHub shows (140 characters at most).
report() {
	local id=$1 state=$2 description=$3
	log "deployment $id: $state: $description"
	[[ -n $DRY_RUN ]] && return 0
	gh api -X POST "repos/$REPO/deployments/$id/statuses" \
		-f state="$state" -f description="${description:0:140}" -F auto_inactive=true >/dev/null
}

latest_state() {
	gh api "repos/$REPO/deployments/$1/statuses?per_page=1" --jq '.[0].state // ""'
}

handled() { case $1 in success | failure | error | inactive) return 0 ;; *) return 1 ;; esac }

version_of() { "$1" --version 2>/dev/null | awk '{print $2}'; }

# The instances to restart: UNITS, or every runner unit loaded here, both the plain
# zig-runner.service (deploy/zig-runner.service) and instances of a zig-runner@.service template.
instances() {
	if [[ -n $UNITS ]]; then
		local listed
		read -ra listed <<<"$UNITS"
		printf '%s\n' "${listed[@]}"
	else
		systemctl list-units --all --plain --no-legend 'zig-runner.service' 'zig-runner@*.service' |
			awk '{print $1}'
	fi
}

# The instances systemd does not know (a mistyped UNITS): restarting one would fail only after the
# release is installed, and roll every instance back for nothing.
unknown_units() {
	local unit
	for unit in "$@"; do
		[[ $(systemctl show -p LoadState --value "$unit") == loaded ]] || echo "$unit"
	done
}

# Whether $1 runs the binary installed now: active, and its process's executable is BIN itself. A
# process started from a binary since replaced shows it as "BIN (deleted)": the file on disk alone
# does not say the instances restarted (the agent may have stopped between installing and that).
runs_installed() {
	local pid
	systemctl is-active --quiet "$1" || return 1
	pid=$(systemctl show -p MainPID --value "$1")
	[[ $pid != 0 && $(readlink "/proc/$pid/exe") == "$BIN" ]]
}

# Whether the process systemd started as invocation $2 of $1 has said it is listening. The runner
# says so after every job too, and a stopping process may still say it: only this invocation counts.
listening() {
	systemctl is-active --quiet "$1" &&
		journalctl "_SYSTEMD_INVOCATION_ID=$2" -o cat --no-pager | grep -q 'listening for jobs'
}

# Restarts the instances given; prints the first that does not come back listening, or nothing.
restart_all() {
	local unit invocation deadline
	for unit in "$@"; do
		# A stop lets running jobs finish first (the unit's TimeoutStopSec).
		if ! systemctl restart "$unit"; then
			echo "$unit"
			return
		fi
		invocation=$(systemctl show -p InvocationID --value "$unit")
		deadline=$((SECONDS + HEALTH_SECONDS))
		until listening "$unit" "$invocation"; do
			if ((SECONDS >= deadline)); then
				echo "$unit"
				return
			fi
			sleep 3
		done
	done
}

# Puts $1 at BIN in one step: written beside it, then renamed over it, so BIN is never missing or
# half written.
put() {
	install -m 0755 "$1" "$BIN.new" && mv -f "$BIN.new" "$BIN"
}

# Restarts the instances given onto the installed binary, and reports. If one does not come back,
# the previous binary goes back and every instance is restarted onto it.
finish() {
	local down again
	if [[ -n $DRY_RUN ]]; then
		log "dry run: would restart $* onto $tag"
		exit 0
	fi
	down=$(restart_all "$@")
	if [[ -z $down ]]; then
		report "$id" success "running $tag on $(hostname): $*"
		exit 0
	fi
	if [[ -x $BIN.prev && $(version_of "$BIN.prev") != "$tag" ]] && put "$BIN.prev"; then
		again=$(restart_all "${units[@]}")
		fail "$tag did not come up on $down; back on $(version_of "$BIN")${again:+, $again down}"
	fi
	fail "$tag did not come up on $down, and there is no other binary to go back to"
}

fail() {
	report "$id" failure "$1"
	exit 1
}

# A try at deployment $id failed for a reason of the moment ($1): exits without reporting, so the
# timer tries again, until the ATTEMPTS-th try, which reports the deployment failed.
transient() {
	local tries=1 last_id last_tries
	if read -r last_id last_tries 2>/dev/null <"$STATE_DIR/tries" && [[ $last_id == "$id" ]]; then
		tries=$((last_tries + 1))
	fi
	((tries < ATTEMPTS)) || fail "gave up after $tries tries: $1"
	if [[ -z $DRY_RUN ]]; then
		echo "$id $tries" >"$STATE_DIR/tries" || log "could not count the try in $STATE_DIR/tries"
	fi
	log "deployment $id: try $tries of $ATTEMPTS: $1; trying again next time"
	exit 0
}

# fetch WHAT GH_ARGS...: runs gh, its output going where this function's goes. A release, asset
# or attestation that does not exist fails the deployment; any other failure is transient.
fetch() {
	local what=$1 err status=0
	shift
	{ err=$(gh "$@" 2>&1 1>&3 3>&-); } 3>&1 || status=$?
	((status == 0)) && return 0
	if ((status == 124)); then err="timed out after $GH_TIMEOUT s"; fi
	err=$(tail -n1 <<<"${err:-gh exited $status}")
	case $err in
	*"HTTP 404"* | *"release not found"* | *"no assets match"*) fail "$what: $err" ;;
	*) transient "$what: $err" ;;
	esac
}

# Whether version tag $1 is older than version tag $2.
older() { [[ $1 != "$2" && $(printf '%s\n' "$1" "$2" | sort -V | head -n1) == "$1" ]]; }

# What this machine needs is checked before any deployment is touched: a deployment reported failed
# for a missing tool would never be tried again, so this exits and the timer tries next minute.
attestation_help=$(gh attestation verify --help 2>&1) || true
for flag in --signer-workflow --source-ref --deny-self-hosted-runners --custom-trusted-root; do
	if [[ $attestation_help != *"$flag"* ]]; then
		log "$(gh --version | head -n1) cannot verify provenance (gh attestation verify $flag):" \
			"install gh 2.68 or later from https://cli.github.com (Debian's package is too old)"
		exit 1
	fi
done

mapfile -t ids < <(
	gh api "repos/$REPO/deployments?environment=$ENVIRONMENT&per_page=10" --jq '.[].id'
)
((${#ids[@]} > 0)) || exit 0
id=${ids[0]}
handled "$(latest_state "$id")" && exit 0

tag=$(gh api "repos/$REPO/deployments/$id" --jq .ref)
log "deployment $id: $tag"
# Older deployments nobody got to: this newer one replaces them.
for old in "${ids[@]:1}"; do
	handled "$(latest_state "$old")" || report "$old" inactive "superseded by $tag"
done

[[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "not a version tag: $tag"
mapfile -t units < <(instances)
((${#units[@]} > 0)) || fail "no zig-runner instances on $(hostname)"
mapfile -t unknown < <(unknown_units "${units[@]}")
((${#unknown[@]} == 0)) || fail "no unit ${unknown[*]} on $(hostname) (UNITS); nothing installed"

current=$(version_of "$BIN" || true)
# Anyone who can create a deployment could otherwise put back an older release, attested as
# genuinely as any, with the bugs since fixed.
if [[ $current =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && older "$tag" "$current" && [[ $ALLOW_DOWNGRADE != "$tag" ]]; then
	fail "$tag is older than the installed $current: refused (ALLOW_DOWNGRADE=$tag on $(hostname) allows it)"
fi

# Installed already: done if every instance runs it; otherwise restart those that do not.
if [[ $current == "$tag" ]]; then
	stale=()
	for unit in "${units[@]}"; do runs_installed "$unit" || stale+=("$unit"); done
	if ((${#stale[@]} == 0)); then
		report "$id" success "already running $tag"
		exit 0
	fi
	report "$id" in_progress "$tag is installed; restarting ${stale[*]} onto it"
	finish "${stale[@]}"
fi

report "$id" in_progress "installing $tag on $(hostname) (was ${current:-none})"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
asset="zig-runner-linux-$(uname -m)"
# Each check runs offline, on what was fetched before it, into $work (gh attestation download
# writes there): the binary and SHA256SUMS, then the attestations of the binary's digest and
# Sigstore's trust root.
cd "$work"
fetch "could not download $tag's $asset" release download "$tag" -R "$REPO" -D "$work" -p "$asset" -p SHA256SUMS
grep -q "  $asset\$" SHA256SUMS || fail "$asset is not in $tag's SHA256SUMS"
sha256sum --check --ignore-missing --quiet SHA256SUMS ||
	fail "$asset does not match $tag's SHA256SUMS"
digest=$(sha256sum "$asset" | cut -d' ' -f1)
fetch "could not fetch $asset's attestations" attestation download "$asset" -R "$REPO" >/dev/null
fetch "could not fetch Sigstore's trust root" attestation trusted-root >"$work/trusted_root.jsonl"
gh attestation verify "$work/$asset" --repo "$REPO" \
	--bundle "$work/sha256:$digest.jsonl" --custom-trusted-root "$work/trusted_root.jsonl" \
	--signer-workflow "$REPO/.github/workflows/release.yml" \
	--source-ref "refs/tags/$tag" --deny-self-hosted-runners >/dev/null ||
	fail "$asset has no provenance from release.yml at $tag"
chmod 0755 "$work/$asset"
[[ $(version_of "$work/$asset") == "$tag" ]] || fail "$asset does not say it is $tag"

if [[ -z $DRY_RUN ]]; then
	if [[ -e $BIN ]]; then cp -p "$BIN" "$BIN.prev" || fail "could not keep the previous binary"; fi
	put "$work/$asset" || fail "could not install $tag at $BIN (it is unchanged)"
fi
finish "${units[@]}"
