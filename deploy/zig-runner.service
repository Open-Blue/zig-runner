# The runner as a systemd service, next to a Dagger engine started with a unix socket
# (the deployment guide's "As a systemd service",
# https://github.com/Lementknight/zig-actions-runner/blob/7641a69/docs/DEPLOY.md). Install:
#
#   sudo install -m 0755 runner /usr/local/bin/zig-runner
#   sudo install -m 0600 runner.env /etc/zig-runner.env
#   sudo cp zig-runner.service /etc/systemd/system/ && sudo systemctl enable --now zig-runner
[Unit]
Description=Zig GitHub Actions runner pool
After=network-online.target docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/zig-runner.env
Environment=RUNNER_ENGINE_HOST=unix:///run/dagger/engine.sock
ExecStart=/usr/local/bin/zig-runner
# SIGTERM: waiting runners stop and remove their registrations; running jobs get
# RUNNER_STOP_GRACE_SECS (10 minutes by default) to finish, then are cancelled as GitHub cancels a
# job: the running step stops, always() steps and post scripts get 1 minute, the job is reported.
# 15 minutes leaves that, and the reports, room; past it systemd kills the runner, the engine
# stops its steps, and GitHub fails its jobs once their hold runs out. Raise both together.
KillSignal=SIGTERM
TimeoutStopSec=15min
Restart=on-failure
RestartSec=10
# Exit 1 (configuration) and 2 (GitHub refused the token or scope) need a fix, not a restart.
RestartPreventExitStatus=1 2
# A runner that runs away takes this unit down, and systemd restarts it, instead of the kernel
# choosing what to kill on the host. Over what native jobs may hold together, as jobs count here
# with RUNNER_NATIVE_CGROUP=self, where their limit is figured from this one. Page cache is
# reclaimed first, so it counts for little.
MemoryMax=90%
# The runner needs no files of its own, only the network and the engine's socket (owned by root
# unless the engine was started otherwise; to run unprivileged, set User= to an account that can
# open it).
# Pools on one machine share what they have reserved in /run/zig-runner/memory-budget
# (RUNNER_SHARED_MEMORY_BUDGET); under ProtectSystem=strict that directory is writable only with:
# RuntimeDirectory=zig-runner
# RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
