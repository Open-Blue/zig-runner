# Settings for zig-runner-deploy (docs/OPERATIONS.md, "Deploying releases"). Copy to
# /etc/zig-runner-deploy.env; keep it private.

# A fine-grained token for REPO only: Deployments read and write; Attestations and Contents read.
GH_TOKEN=
REPO=Open-Blue/zig-runner
# The GitHub environment the release workflow deploys this machine as.
ENVIRONMENT=razorbill
# The instances to restart, space-separated; unset for every zig-runner.service and
# zig-runner@*.service loaded here.
# An instance trusted less than prod (a sandbox) gets an engine of its own (docs/OPERATIONS.md, "Environments").
# UNITS=zig-runner@ci.service zig-runner@sandbox.service
# BIN=/usr/local/bin/zig-runner
# Seconds any one call to GitHub may take.
# GH_TIMEOUT=120
# Tries, one a minute, of a deployment whose release could not be fetched (no network, a rate
# limit, Sigstore's CDN) before it is reported failed.
# ATTEMPTS=30
# A release older than the installed one is refused. To roll back on purpose, name that one
# version here, deploy it, and remove the line again.
# ALLOW_DOWNGRADE=v1.2.3
