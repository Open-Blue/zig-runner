# Zig
.zig-cache/
zig-cache/
zig-out/
*.o
*.obj

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
.credentials*
.runner

# Node (api/, web/)
node_modules/
dist/
build/
.next/
*.tsbuildinfo
npm-debug.log*

# Runner work directories
_work/

# Editors and OS
.vscode/
.idea/
.DS_Store
*.swp

# Runner configuration with credentials (deploy/runner.env.example is the template).
deploy/runner.env

# A zls clone someone keeps here; not part of this repository.
zls/

# Lean's build output (proofs/).
.lake/
__pycache__/

# Zig 0.17 unpacks build.zig.zon dependencies here.
zig-pkg/

# .NET builds of runner/tools/regexdiff/reference, which editors with C# support make on their own.
runner/tools/regexdiff/reference/bin/
runner/tools/regexdiff/reference/obj/

# The release binaries the image build takes (release.yml, the Dockerfile's prebuilt stage).
runner/prebuilt/
# What `go build` writes in a Go tool's directory: the command, named after its directory. #503
# committed yamldiff's (4.9 MB) from a `go build ./...` there.
runner/tools/exprdiff/exprdiff
runner/tools/gitea-jobdiff/gitea-jobdiff
runner/tools/hashfilesdiff/hashfilesdiff
runner/tools/hpackdiff/hpackdiff
runner/tools/regexdiff/regexdiff
runner/tools/rsadiff/rsadiff
runner/tools/yamldiff/yamldiff
