#!/usr/bin/env bash
# Before a push: the checks CI runs on a pull request, on exactly the commits being pushed (each is
# checked out in a temporary worktree, so uncommitted changes neither help nor hurt):
#
#   - the branch name's prefix (CI's "Branch name"; it decides the release, README "Versioning");
#   - zig fmt, GitHub's expression cases, and the build and tests ("Tests (x86_64)");
#     the database tests run too when PG* or ZIG_TEST_PG_URL point at a database; when the
#     runner's code changed, the tests again on overlayfs, in Docker ("Test, on overlayfs":
#     #332 passed every pull request and failed on main), and ZLint with its suppressed-errors
#     check ("Lint (ZLint)": #327's and #332's `catch {}` reached the nightly first);
#   - actionlint and zizmor, and the check names the release waits for (check-names.sh), when
#     workflows changed, shellcheck and shfmt, when shell scripts did,
#     and hadolint, when the Dockerfile did ("Workflows"), and the unsafe constructs ratchet, always;
#   - gofmt and go vet for the Go tools under runner/tools, when they changed;
#   - the Lean proofs, and the hashFiles model against glob.zig, when either changed ("Proofs");
#   - TLC, when the TLA+ specifications or the release pipeline they model changed ("TLC"; it takes
#     minutes), and SPIN, when the store's locking models changed (TLA+ or their Promela port in
#     proofs/spin). CI also runs both on changes to the store's code, which the hook leaves to CI.
#
# README, "Git hooks".
set -euo pipefail
hook=pre-push
top=$(git rev-parse --show-toplevel)
cd "$top"
. .githooks/common.sh
# Git may hand hooks these; inside the worktree they would point back here.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

zero=0000000000000000000000000000000000000000
checked=false
while read -r _local_ref local_sha remote_ref remote_sha; do
	[[ $local_sha == "$zero" ]] && continue # a deletion
	case $remote_ref in
	refs/heads/*) branch=${remote_ref#refs/heads/} ;;
	*) continue ;; # tags: the release workflow makes those
	esac
	case $branch in
	feature/?* | feat/?* | bugfix/?* | hotfix/?* | ci/?* | release/?* | docs/?* | perf/?* | refactor/?* | renovate/?*) ;;
	main) fail "pushing to main: main takes changes through pull requests" ;;
	*) fail "'$branch' needs one of the prefixes feature/, feat/, bugfix/, hotfix/, ci/, release/, docs/, perf/ or refactor/ (README, \"Versioning\")" ;;
	esac

	# What changed: against the remote branch, or where a new branch left main.
	base=$remote_sha
	[[ $base == "$zero" ]] && base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
	if [[ -n $base ]]; then
		changed=$(git diff --name-only "$base" "$local_sha")
	else
		changed=$(git ls-tree -r --name-only "$local_sha")
	fi

	$checked || use_zig "$top"
	checked=true
	tree=$(mktemp -d)
	trap 'git -C "$top" worktree remove --force "$tree" >/dev/null 2>&1 || true; rm -rf "$tree"' EXIT
	git worktree add --detach --quiet "$tree" "$local_sha"
	say "checking $branch at ${local_sha:0:8}"
	(
		cd "$tree/runner"
		zig fmt --check build.zig build.zig.zon src tools >/dev/null || fail "zig fmt: run zig fmt on the files above"
		say "GitHub's expression cases"
		../.github/scripts/expr-conformance.sh >/dev/null || fail "expressions: ../.github/scripts/expr-conformance.sh --report shows what changed"
		say "build and tests"
		log=$(mktemp)
		if ! ../.github/scripts/zig-test.sh >"$log" 2>&1; then
			grep -E 'FAIL|error|passed;' "$log" | tail -20 >&2
			rm -f "$log"
			fail "the build or the tests failed"
		fi
		grep "passed;" "$log" | tail -1 | sed "s/^/$hook: /" >&2
		rm -f "$log"
		say "every test file is compiled"
		../.github/scripts/test-files.sh >/dev/null || fail "a file's tests are not in the test binary: ../.github/scripts/test-files.sh shows which"
		if grep -qE '^runner/|^db/|^\.github/scripts/(zig-test|zig-modules|zlint)\.sh$|^\.github/scripts/zlint-suppressed\.baseline$' <<<"$changed"; then
			say "the tests on overlayfs, in Docker"
			if ! command -v docker >/dev/null || ! docker info >/dev/null 2>&1; then
				fail "the runner's code changed, and its tests on overlayfs need Docker running (CI's \"Test, on overlayfs\")"
			fi
			log=$(mktemp)
			if ! ZIG_TEST_IN_CONTAINER=1 ZIG_TEST_MIN_PASSED=500 ../.github/scripts/zig-test.sh >"$log" 2>&1; then
				grep -E 'FAIL|error|passed;|fewer than' "$log" | tail -20 >&2
				rm -f "$log"
				fail "the tests failed on overlayfs (ZIG_TEST_IN_CONTAINER=1 ../.github/scripts/zig-test.sh)"
			fi
			grep "passed;" "$log" | tail -1 | sed "s/^/$hook: on overlayfs: /" >&2
			rm -f "$log"
			say "ZLint, and its suppressed-errors check"
			../.github/scripts/zlint.sh >/dev/null || fail "ZLint found problems: ../.github/scripts/zlint.sh shows them"
			../.github/scripts/zlint.sh suppressed-errors >/dev/null ||
				fail "a new catch {} or catch unreachable: ../.github/scripts/zlint.sh suppressed-errors shows it"
		fi
	)
	say "unsafe constructs ratchet"
	(cd "$tree" && .github/scripts/unsafe-ratchet.sh >/dev/null) || fail "more unsafe casts than the baseline: .github/scripts/unsafe-ratchet.sh shows which"
	if grep -qE '\.sh$|^\.githooks/|^deploy/zig-runner-deploy$' <<<"$changed"; then
		say "shellcheck"
		(cd "$tree" && .github/scripts/shellcheck.sh >/dev/null) || fail "shellcheck found problems: .github/scripts/shellcheck.sh shows them"
		say "shfmt"
		(cd "$tree" && .github/scripts/shfmt.sh >/dev/null 2>&1) || fail "shell scripts not formatted: .github/scripts/shfmt.sh -w formats them"
	fi
	if grep -qE '(^|/)Dockerfile' <<<"$changed"; then
		say "hadolint"
		(cd "$tree" && .github/scripts/hadolint.sh >/dev/null) || fail "hadolint found problems: .github/scripts/hadolint.sh shows them"
	fi
	if grep -q '^\.github/workflows/' <<<"$changed"; then
		say "actionlint and zizmor"
		(cd "$tree" && go run github.com/rhysd/actionlint/cmd/actionlint@v1.7.12) || fail "actionlint found problems"
		command -v python3 >/dev/null ||
			fail "workflows changed, and zizmor needs python3 with venv to run (.github/scripts/zizmor.sh)"
		(cd "$tree" && .github/scripts/zizmor.sh .github/workflows) || fail "zizmor found problems"
	fi
	if grep -q -e '^\.github/workflows/' -e '^\.github/checks-on-main$' <<<"$changed"; then
		say "the check names the pipeline waits for"
		(cd "$tree" && .github/scripts/check-names.sh) || fail "a check name the pipeline waits for is not a job that runs then (.github/scripts/check-names.sh)"
	fi
	while read -r mod; do
		[[ -n $mod && -f $tree/$mod/go.mod ]] || continue
		say "gofmt and go vet $mod"
		[[ -z $(cd "$tree/$mod" && gofmt -l .) ]] || fail "gofmt: $mod is not formatted"
		(cd "$tree/$mod" && go vet ./...) || fail "go vet found problems in $mod"
	done < <(grep -o '^runner/tools/[^/]*/' <<<"$changed" | sort -u)
	if grep -qE '^proofs/|^runner/src/glob\.zig$|^runner/tools/globleancorpus\.zig$|^\.github/scripts/glob-lean-diff\.sh$' <<<"$changed"; then
		say "the proofs, and the hashFiles model against glob.zig"
		# elan installs lake in ~/.elan/bin without necessarily putting it on PATH.
		command -v lake >/dev/null || PATH="$HOME/.elan/bin:$PATH"
		command -v lake >/dev/null || fail "proofs/ or glob.zig changed, and checking them needs Lean (proofs/README.md)"
		(cd "$tree/proofs" && lake build >/dev/null) || fail "the proofs do not check: run lake build in proofs/"
		(cd "$tree" && .github/scripts/glob-lean-diff.sh 2000 "$RANDOM" >&2) || fail "glob.zig and the Lean model differ"
	fi
	if grep -qE '^proofs/tla/|^\.github/workflows/(version|release|store-model)\.yml$|^\.github/scripts/(next-version|wait-for-checks|check-names|tlc)\.sh$|^\.github/checks-on-main$' <<<"$changed"; then
		say "TLC, the store's and the release pipeline's models (minutes)"
		command -v java >/dev/null || fail "the TLA+ models or the release pipeline changed, and TLC needs Java 11 or later (.github/scripts/tlc.sh)"
		(cd "$tree" && TLC_DIR="${TLC_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zig-runner-tlc}" .github/scripts/tlc.sh >/dev/null) ||
			fail "TLC found an error: .github/scripts/tlc.sh shows it"
	fi
	if grep -qE '^proofs/(tla|spin)/|^\.github/workflows/store-model\.yml$|^\.github/scripts/spin\.sh$' <<<"$changed"; then
		say "SPIN, the store's locking (a minute)"
		command -v spin >/dev/null || fail "the store's locking models changed, and checking them needs SPIN 6.5.2 (.github/scripts/spin.sh)"
		(cd "$tree" && SPIN_DIR="${SPIN_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zig-runner-spin}" .github/scripts/spin.sh >/dev/null) ||
			fail "SPIN found an error: .github/scripts/spin.sh shows it"
	fi
	git worktree remove --force "$tree"
	trap - EXIT
done
